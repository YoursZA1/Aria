# Google Custom Search JSON API — server only, never VITE_ (that would leak to the browser)
# https://developers.google.com/custom-search/v1/overview#api_key
#
# 1. Create a Programmable Search Engine: https://programmablesearchengine.google.com/
#    Turn on "Search the entire web"
# 2. Copy the Search engine ID → GOOGLE_CSE_CX
# 3. Enable Custom Search API and create an API key → GOOGLE_CSE_API_KEY
#    https://console.cloud.google.com/apis/credentials
#
# 100 free queries / day. Google is not taking new CSE JSON customers after this product line;
# existing keys still work until 1 Jan 2027.

GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# OpenAI Chat Completions — server only, never VITE_ (that would leak to the browser)
# https://platform.openai.com/api-keys
# Aria uses ChatGPT (gpt-4o-mini) for the reply Mando sees. Local retrieve supplies facts.

OPENAI_API_KEY=

# Cursor SDK — server only, never VITE_ (that would leak to the browser)
# User key: https://cursor.com/dashboard/integrations
# Team service-account key: Team Settings → Service accounts
# Restart Vite after changing this. Aria uses Agent.create (local) against this workspace.

CURSOR_API_KEY=

# Optional sibling product folders if they are not next to this repo.
# ARIA_PAIDLY_CWD=
# ARIA_BRANDCAFE_CWD=
